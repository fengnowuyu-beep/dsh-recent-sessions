{
  "name": "dsh-recent-sessions",
  "version": "0.1.0",
  "type": "module",
  "description": "Adds a collapsible Recent sessions group at the top of the workspace list in the DSH sidebar, with status marks, a hover card, its own settings, and the host session menu.",
  "license": "MIT",
  "author": "customized from kyrsieger/dsh-up-session",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "session",
    "recent"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets/*.png",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
